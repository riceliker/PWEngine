# PWMake 0.1.0
# ===== Compiler =====
compiler_path = /opt/homebrew/opt/llvm/bin/clang++
compiler_flags = -std=c++23 -stdlib=libc++ -I./include  -I./runtime  -I./thirdparty  -I/opt/homebrew/opt/GLFW/include  -I/opt/homebrew/opt/vulkan-headers/include  -I/opt/homebrew/opt/shaderc/include  -g -O0
rule compile
  command = $compiler_path $compiler_flags -c $in -o $out -MD -MF $out.d
  depfile = $out.d
  deps = gcc
rule compile_lib
  command = $compiler_path $compiler_flags -fPIC -c $in -o $out -MD -MF $out.d
  depfile = $out.d
  deps = gcc
link_flags = -stdlib=libc++ -framework Metal  
rule binary
  command = $compiler_path $in -o $out $link_flags
ar = ar
rule static_library
  command = $ar rc $out $in
rule shared_library
  command = $compiler_path -shared $in -o $out $link_flags
# ===== Make Object =====
obj = ./build/obj
bin = ./build/libPWEngine.dylib
build $obj/PWEngine/runtime/core/file/shader.o: compile runtime/core/file/shader.cpp
build $obj/PWEngine/runtime/core/file/obj.o: compile runtime/core/file/obj.cpp
build $obj/PWEngine/runtime/core/file/tga.o: compile runtime/core/file/tga.cpp
build $obj/PWEngine/runtime/core/render/pipeline/shader.o: compile runtime/core/render/pipeline/shader.cpp
build $obj/PWEngine/runtime/core/render/pipeline/builder.o: compile runtime/core/render/pipeline/builder.cpp
build $obj/PWEngine/runtime/core/render/context/uniform.o: compile runtime/core/render/context/uniform.cpp
build $obj/PWEngine/runtime/core/render/context/window.o: compile runtime/core/render/context/window.cpp
build $obj/PWEngine/runtime/core/render/context/context.o: compile runtime/core/render/context/context.cpp
build $obj/PWEngine/runtime/core/render/context/descripter.o: compile runtime/core/render/context/descripter.cpp
build $obj/PWEngine/runtime/core/render/context/texture.o: compile runtime/core/render/context/texture.cpp
build $obj/PWEngine/runtime/core/render/context/buffer.o: compile runtime/core/render/context/buffer.cpp
build $obj/PWEngine/runtime/core/render/context/swapchain.o: compile runtime/core/render/context/swapchain.cpp
build $obj/PWEngine/runtime/core/render/context/check.o: compile runtime/core/render/context/check.cpp
build $obj/PWEngine/runtime/core/render/input/mouse.o: compile runtime/core/render/input/mouse.cpp
build $obj/PWEngine/runtime/core/render/input/keyborad.o: compile runtime/core/render/input/keyborad.cpp
build $obj/PWEngine/runtime/core/render/node3D/mesh.o: compile runtime/core/render/node3D/mesh.cpp
build $obj/PWEngine/runtime/core/render/node3D/camera.o: compile runtime/core/render/node3D/camera.cpp
build $obj/PWEngine/runtime/core/render/node3D/node.o: compile runtime/core/render/node3D/node.cpp
build $obj/PWEngine/runtime/core/render/node3D/pipeline.o: compile runtime/core/render/node3D/pipeline.cpp
build $obj/PWEngine/runtime/core/render/node3D/transform.o: compile runtime/core/render/node3D/transform.cpp
build $obj/PWEngine/runtime/core/render/node3D/material.o: compile runtime/core/render/node3D/material.cpp
build $obj/PWEngine/runtime/core/render/instance/validlayer.o: compile runtime/core/render/instance/validlayer.cpp
build $obj/PWEngine/runtime/core/render/instance/instance.o: compile runtime/core/render/instance/instance.cpp
build $obj/PWEngine/runtime/core/render/loop/loop.o: compile runtime/core/render/loop/loop.cpp
build $obj/PWEngine/runtime/core/render/loop/frame.o: compile runtime/core/render/loop/frame.cpp
build $obj/PWEngine/runtime/core/render/loop/command.o: compile runtime/core/render/loop/command.cpp
build $obj/PWEngine/runtime/core/render/loop/singletimer.o: compile runtime/core/render/loop/singletimer.cpp
build $obj/PWEngine/runtime/core/render/loop/rendering.o: compile runtime/core/render/loop/rendering.cpp
build $obj/PWEngine/runtime/core/render/hud/pipeline.o: compile runtime/core/render/hud/pipeline.cpp
build $obj/PWEngine/runtime/stream/log.o: compile runtime/stream/log.cpp
build $obj/PWEngine/runtime/stream/config.o: compile runtime/stream/config.cpp
build $obj/PWEngine/runtime/stb/image.o: compile runtime/stb/image.cpp
build $bin: shared_library $obj/PWEngine/runtime/core/file/shader.o $obj/PWEngine/runtime/core/file/obj.o $obj/PWEngine/runtime/core/file/tga.o $obj/PWEngine/runtime/core/render/pipeline/shader.o $obj/PWEngine/runtime/core/render/pipeline/builder.o $obj/PWEngine/runtime/core/render/context/uniform.o $obj/PWEngine/runtime/core/render/context/window.o $obj/PWEngine/runtime/core/render/context/context.o $obj/PWEngine/runtime/core/render/context/descripter.o $obj/PWEngine/runtime/core/render/context/texture.o $obj/PWEngine/runtime/core/render/context/buffer.o $obj/PWEngine/runtime/core/render/context/swapchain.o $obj/PWEngine/runtime/core/render/context/check.o $obj/PWEngine/runtime/core/render/input/mouse.o $obj/PWEngine/runtime/core/render/input/keyborad.o $obj/PWEngine/runtime/core/render/node3D/mesh.o $obj/PWEngine/runtime/core/render/node3D/camera.o $obj/PWEngine/runtime/core/render/node3D/node.o $obj/PWEngine/runtime/core/render/node3D/pipeline.o $obj/PWEngine/runtime/core/render/node3D/transform.o $obj/PWEngine/runtime/core/render/node3D/material.o $obj/PWEngine/runtime/core/render/instance/validlayer.o $obj/PWEngine/runtime/core/render/instance/instance.o $obj/PWEngine/runtime/core/render/loop/loop.o $obj/PWEngine/runtime/core/render/loop/frame.o $obj/PWEngine/runtime/core/render/loop/command.o $obj/PWEngine/runtime/core/render/loop/singletimer.o $obj/PWEngine/runtime/core/render/loop/rendering.o $obj/PWEngine/runtime/core/render/hud/pipeline.o $obj/PWEngine/runtime/stream/log.o $obj/PWEngine/runtime/stream/config.o $obj/PWEngine/runtime/stb/image.o /opt/homebrew/opt/GLFW/lib/libGLFW.dylib /opt/homebrew/opt/vulkan-loader/lib/libvulkan.dylib /opt/homebrew/opt/shaderc/lib/libshaderc_shared.dylib /opt/homebrew/opt/molten-vk/lib/libMoltenVK.dylib 
default $bin
# ===== Make Object =====
obj = ./build/obj
bin = ./build/test
build $obj/test/test/VikingRoom/main.o: compile test/VikingRoom/main.cpp
build $bin: binary $obj/test/test/VikingRoom/main.o ./build/libPWEngine.dylib 
default $bin
