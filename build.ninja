# PWMake 0.1.0
# ===== Compiler =====
compiler_path = /opt/homebrew/opt/llvm/bin/clang++
compiler_flags = -std=c++23 -stdlib=libc++ -I./include  -I/opt/homebrew/opt/GLFW/include  -I/opt/homebrew/opt/vulkan-headers/include  -g -O0
rule compile
  command = $compiler_path $compiler_flags -c $in -o $out -MD -MF $out.d
  depfile = $out.d
  deps = gcc
rule compile_lib
  command = $compiler_path $compiler_flags -fPIC -c $in -o $out -MD -MF $out.d
  depfile = $out.d
  deps = gcc
link_flags = -stdlib=libc++ -framework Metal  
rule binary
  command = $compiler_path $in -o $out $link_flags
ar = ar
rule static_library
  command = $ar rc $out $in
rule shared_library
  command = $compiler_path -shared $in -o $out $link_flags
# ===== Make Object =====
obj = ./build/obj
bin = ./build/libPWEngine.dylib
build $obj/PWEngine/runtime/file/shader.o: compile runtime/file/shader.cpp
build $obj/PWEngine/runtime/file/obj.o: compile runtime/file/obj.cpp
build $obj/PWEngine/runtime/file/tga.o: compile runtime/file/tga.cpp
build $obj/PWEngine/runtime/stream/log.o: compile runtime/stream/log.cpp
build $obj/PWEngine/runtime/stream/config.o: compile runtime/stream/config.cpp
build $obj/PWEngine/runtime/render/context/loop.o: compile runtime/render/context/loop.cpp
build $obj/PWEngine/runtime/render/context/window.o: compile runtime/render/context/window.cpp
build $obj/PWEngine/runtime/render/context/context.o: compile runtime/render/context/context.cpp
build $obj/PWEngine/runtime/render/context/pipeline.o: compile runtime/render/context/pipeline.cpp
build $obj/PWEngine/runtime/render/context/swapchain.o: compile runtime/render/context/swapchain.cpp
build $obj/PWEngine/runtime/render/input/mouse.o: compile runtime/render/input/mouse.cpp
build $obj/PWEngine/runtime/render/input/keyborad.o: compile runtime/render/input/keyborad.cpp
build $obj/PWEngine/runtime/render/instance/instance.o: compile runtime/render/instance/instance.cpp
build $obj/PWEngine/runtime/render/command/frame.o: compile runtime/render/command/frame.cpp
build $obj/PWEngine/runtime/render/command/singletimer.o: compile runtime/render/command/singletimer.cpp
build $obj/PWEngine/runtime/render/node/mesh.o: compile runtime/render/node/mesh.cpp
build $obj/PWEngine/runtime/render/node/camera.o: compile runtime/render/node/camera.cpp
build $obj/PWEngine/runtime/render/node/node.o: compile runtime/render/node/node.cpp
build $obj/PWEngine/runtime/render/node/texture.o: compile runtime/render/node/texture.cpp
build $obj/PWEngine/runtime/render/node/material.o: compile runtime/render/node/material.cpp
build $obj/PWEngine/runtime/render/node/vertex.o: compile runtime/render/node/vertex.cpp
build $bin: shared_library $obj/PWEngine/runtime/file/shader.o $obj/PWEngine/runtime/file/obj.o $obj/PWEngine/runtime/file/tga.o $obj/PWEngine/runtime/stream/log.o $obj/PWEngine/runtime/stream/config.o $obj/PWEngine/runtime/render/context/loop.o $obj/PWEngine/runtime/render/context/window.o $obj/PWEngine/runtime/render/context/context.o $obj/PWEngine/runtime/render/context/pipeline.o $obj/PWEngine/runtime/render/context/swapchain.o $obj/PWEngine/runtime/render/input/mouse.o $obj/PWEngine/runtime/render/input/keyborad.o $obj/PWEngine/runtime/render/instance/instance.o $obj/PWEngine/runtime/render/command/frame.o $obj/PWEngine/runtime/render/command/singletimer.o $obj/PWEngine/runtime/render/node/mesh.o $obj/PWEngine/runtime/render/node/camera.o $obj/PWEngine/runtime/render/node/node.o $obj/PWEngine/runtime/render/node/texture.o $obj/PWEngine/runtime/render/node/material.o $obj/PWEngine/runtime/render/node/vertex.o /opt/homebrew/opt/GLFW/lib/libGLFW.dylib /opt/homebrew/opt/vulkan-loader/lib/libvulkan.dylib /opt/homebrew/opt/molten-vk/lib/libMoltenVK.dylib 
default $bin
# ===== Make Object =====
obj = ./build/obj
bin = ./build/test
build $obj/test/test/main.o: compile test/main.cpp
build $bin: binary $obj/test/test/main.o ./build/libPWEngine.dylib 
default $bin
