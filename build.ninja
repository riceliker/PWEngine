# PWMake 0.1.0
# ===== Compiler =====
compiler_path = /opt/homebrew/opt/llvm/bin/clang++
compiler_flags = -std=c++23 -stdlib=libc++ -I./include  -I./runtime  -I./thirdparty  -I/opt/homebrew/opt/GLFW/include  -I/opt/homebrew/opt/vulkan-headers/include  -I/opt/homebrew/opt/shaderc/include  -g -O0
rule compile
  command = $compiler_path $compiler_flags -c $in -o $out -MD -MF $out.d
  depfile = $out.d
  deps = gcc
rule compile_lib
  command = $compiler_path $compiler_flags -fPIC -c $in -o $out -MD -MF $out.d
  depfile = $out.d
  deps = gcc
link_flags = -stdlib=libc++ -framework Metal  
rule binary
  command = $compiler_path $in -o $out $link_flags
ar = ar
rule static_library
  command = $ar rc $out $in
rule shared_library
  command = $compiler_path -shared $in -o $out $link_flags
# ===== Make Object =====
obj = ./build/obj
bin = ./build/libPWEngine.dylib
build $obj/PWEngine/runtime/gpu/pipeline/render.o: compile runtime/gpu/pipeline/render.cpp
build $obj/PWEngine/runtime/gpu/pipeline/shader.o: compile runtime/gpu/pipeline/shader.cpp
build $obj/PWEngine/runtime/gpu/pipeline/compute.o: compile runtime/gpu/pipeline/compute.cpp
build $obj/PWEngine/runtime/gpu/memory/binding_buffer.o: compile runtime/gpu/memory/binding_buffer.cpp
build $obj/PWEngine/runtime/gpu/memory/utils.o: compile runtime/gpu/memory/utils.cpp
build $obj/PWEngine/runtime/gpu/memory/image.o: compile runtime/gpu/memory/image.cpp
build $obj/PWEngine/runtime/gpu/memory/local_buffer.o: compile runtime/gpu/memory/local_buffer.cpp
build $obj/PWEngine/runtime/gpu/memory/staging_buffer.o: compile runtime/gpu/memory/staging_buffer.cpp
build $obj/PWEngine/runtime/gpu/memory/image_view.o: compile runtime/gpu/memory/image_view.cpp
build $obj/PWEngine/runtime/gpu/input/input.o: compile runtime/gpu/input/input.cpp
build $obj/PWEngine/runtime/gpu/binding/binding.o: compile runtime/gpu/binding/binding.cpp
build $obj/PWEngine/runtime/gpu/binding/layout.o: compile runtime/gpu/binding/layout.cpp
build $obj/PWEngine/runtime/gpu/window/window.o: compile runtime/gpu/window/window.cpp
build $obj/PWEngine/runtime/gpu/window/command.o: compile runtime/gpu/window/command.cpp
build $obj/PWEngine/runtime/gpu/window/swapchain.o: compile runtime/gpu/window/swapchain.cpp
build $obj/PWEngine/runtime/gpu/window/task.o: compile runtime/gpu/window/task.cpp
build $obj/PWEngine/runtime/gpu/task/normal.o: compile runtime/gpu/task/normal.cpp
build $obj/PWEngine/runtime/gpu/instance/cmdpool.o: compile runtime/gpu/instance/cmdpool.cpp
build $obj/PWEngine/runtime/gpu/instance/run.o: compile runtime/gpu/instance/run.cpp
build $obj/PWEngine/runtime/gpu/instance/device.o: compile runtime/gpu/instance/device.cpp
build $obj/PWEngine/runtime/gpu/instance/instance.o: compile runtime/gpu/instance/instance.cpp
build $obj/PWEngine/runtime/gpu/command/copy.o: compile runtime/gpu/command/copy.cpp
build $obj/PWEngine/runtime/gpu/command/window.o: compile runtime/gpu/command/window.cpp
build $obj/PWEngine/runtime/gpu/command/pipeline.o: compile runtime/gpu/command/pipeline.cpp
build $obj/PWEngine/runtime/gpu/command/rendering.o: compile runtime/gpu/command/rendering.cpp
build $obj/PWEngine/runtime/gpu/command/compute.o: compile runtime/gpu/command/compute.cpp
build $obj/PWEngine/runtime/file/image/png.o: compile runtime/file/image/png.cpp
build $obj/PWEngine/runtime/file/image/tga.o: compile runtime/file/image/tga.cpp
build $obj/PWEngine/runtime/stream/log.o: compile runtime/stream/log.cpp
build $obj/PWEngine/runtime/stream/config.o: compile runtime/stream/config.cpp
build $obj/PWEngine/runtime/render/rect/pipeline.o: compile runtime/render/rect/pipeline.cpp
build $bin: shared_library $obj/PWEngine/runtime/gpu/pipeline/render.o $obj/PWEngine/runtime/gpu/pipeline/shader.o $obj/PWEngine/runtime/gpu/pipeline/compute.o $obj/PWEngine/runtime/gpu/memory/binding_buffer.o $obj/PWEngine/runtime/gpu/memory/utils.o $obj/PWEngine/runtime/gpu/memory/image.o $obj/PWEngine/runtime/gpu/memory/local_buffer.o $obj/PWEngine/runtime/gpu/memory/staging_buffer.o $obj/PWEngine/runtime/gpu/memory/image_view.o $obj/PWEngine/runtime/gpu/input/input.o $obj/PWEngine/runtime/gpu/binding/binding.o $obj/PWEngine/runtime/gpu/binding/layout.o $obj/PWEngine/runtime/gpu/window/window.o $obj/PWEngine/runtime/gpu/window/command.o $obj/PWEngine/runtime/gpu/window/swapchain.o $obj/PWEngine/runtime/gpu/window/task.o $obj/PWEngine/runtime/gpu/task/normal.o $obj/PWEngine/runtime/gpu/instance/cmdpool.o $obj/PWEngine/runtime/gpu/instance/run.o $obj/PWEngine/runtime/gpu/instance/device.o $obj/PWEngine/runtime/gpu/instance/instance.o $obj/PWEngine/runtime/gpu/command/copy.o $obj/PWEngine/runtime/gpu/command/window.o $obj/PWEngine/runtime/gpu/command/pipeline.o $obj/PWEngine/runtime/gpu/command/rendering.o $obj/PWEngine/runtime/gpu/command/compute.o $obj/PWEngine/runtime/file/image/png.o $obj/PWEngine/runtime/file/image/tga.o $obj/PWEngine/runtime/stream/log.o $obj/PWEngine/runtime/stream/config.o $obj/PWEngine/runtime/render/rect/pipeline.o /opt/homebrew/opt/GLFW/lib/libGLFW.dylib /opt/homebrew/opt/vulkan-loader/lib/libvulkan.dylib /opt/homebrew/opt/shaderc/lib/libshaderc_shared.dylib /opt/homebrew/opt/molten-vk/lib/libMoltenVK.dylib 
default $bin
# ===== Make Object =====
obj = ./build/obj
bin = ./build/test
build $obj/test/test/gpu-test/compute.o: compile test/gpu-test/compute.cpp
build $bin: binary $obj/test/test/gpu-test/compute.o ./build/libPWEngine.dylib 
default $bin
