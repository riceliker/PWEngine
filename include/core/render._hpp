        struct Impl;
        std::unique_ptr<Impl> self;
        /* Constructor */
        Pipeline(RenderContext* super);
        virtual ~Pipeline();
    };

    class DescriptorSet
    {
    public:
        struct Impl;
        std::unique_ptr<Impl> self; 
        DescriptorSet(Pipeline* pipeline);
        ~DescriptorSet();
        void update(Pipeline* pipeline, Texture2D* texture);
    };

/*
